# Copier ce fichier en .env puis adapter si besoin : cp .env.example .env
# Aucune valeur secrète ici : la sécurité X-Pack est désactivée pour le lab local.

# Version unique pour Elasticsearch, Logstash, Kibana et Filebeat (jamais "latest")
ELK_VERSION=8.15.3

# Ports exposés sur la machine hôte (uniquement sur 127.0.0.1)
ES_PORT=9200
KIBANA_PORT=5601

# Mémoire JVM : Xms = Xmx pour éviter les redimensionnements du tas
ES_JAVA_OPTS=-Xms1g -Xmx1g
LS_JAVA_OPTS=-Xms256m -Xmx256m

# Logs Nginx du projet microservices-ha-cluster (utilisés par generate_logs.py --source)
MICROSERVICES_LOGS=../microservices-ha-cluster/logs/access.log
